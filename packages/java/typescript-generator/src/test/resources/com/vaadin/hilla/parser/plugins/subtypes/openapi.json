{
  "openapi": "3.0.1",
  "info": {
    "title": "Hilla Application",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080/connect",
      "description": "Hilla Backend"
    }
  ],
  "tags": [
    {
      "name": "SubTypesEndpoint",
      "x-class-name": "com.vaadin.hilla.parser.plugins.subtypes.SubTypesEndpoint"
    }
  ],
  "paths": {
    "/SubTypesEndpoint/receiveEvent": {
      "post": {
        "tags": [
          "SubTypesEndpoint"
        ],
        "operationId": "SubTypesEndpoint_receiveEvent_POST",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "event": {
                    "nullable": true,
                    "anyOf": [
                      {
                        "$ref": "#/components/schemas/com.vaadin.hilla.parser.plugins.subtypes.BaseEvent"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        }
      }
    },
    "/SubTypesEndpoint/sendEvent": {
      "post": {
        "tags": [
          "SubTypesEndpoint"
        ],
        "operationId": "SubTypesEndpoint_sendEvent_POST",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "nullable": true,
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/com.vaadin.hilla.parser.plugins.subtypes.BaseEvent"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/SubTypesEndpoint/sendNotification": {
      "post": {
        "tags": [
          "SubTypesEndpoint"
        ],
        "operationId": "SubTypesEndpoint_sendNotification_POST",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "nullable": true,
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/com.vaadin.hilla.parser.plugins.subtypes.Notification"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/SubTypesEndpoint/sendShape": {
      "post": {
        "tags": [
          "SubTypesEndpoint"
        ],
        "operationId": "SubTypesEndpoint_sendShape_POST",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "nullable": true,
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/com.vaadin.hilla.parser.plugins.subtypes.Shape"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "com.vaadin.hilla.parser.plugins.subtypes.BaseEvent": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "com.vaadin.hilla.parser.plugins.subtypes.BaseEventUnion": {
        "type": "object",
        "discriminator": {
          "propertyName": "@type"
        },
        "oneOf": [
          {
            "$ref": "#/components/schemas/com.vaadin.hilla.parser.plugins.subtypes.AddEvent"
          },
          {
            "$ref": "#/components/schemas/com.vaadin.hilla.parser.plugins.subtypes.UpdateEvent"
          },
          {
            "$ref": "#/components/schemas/com.vaadin.hilla.parser.plugins.subtypes.DeleteEvent"
          }
        ]
      },
      "com.vaadin.hilla.parser.plugins.subtypes.AddEvent": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/com.vaadin.hilla.parser.plugins.subtypes.BaseEvent"
          },
          {
            "type": "object",
            "properties": {
              "item": {
                "type": "string",
                "nullable": true
              },
              "@type": {
                "type": "string",
                "example": "add"
              }
            }
          }
        ]
      },
      "com.vaadin.hilla.parser.plugins.subtypes.UpdateEvent": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/com.vaadin.hilla.parser.plugins.subtypes.BaseEvent"
          },
          {
            "type": "object",
            "properties": {
              "oldItem": {
                "type": "string",
                "nullable": true
              },
              "newItem": {
                "type": "string",
                "nullable": true
              },
              "@type": {
                "type": "string",
                "example": "update"
              }
            }
          }
        ]
      },
      "com.vaadin.hilla.parser.plugins.subtypes.DeleteEvent": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/com.vaadin.hilla.parser.plugins.subtypes.BaseEvent"
          },
          {
            "type": "object",
            "properties": {
              "item": {
                "type": "string",
                "nullable": true
              },
              "force": {
                "type": "boolean"
              },
              "@type": {
                "type": "string",
                "example": "delete"
              }
            }
          }
        ]
      },
      "com.vaadin.hilla.parser.plugins.subtypes.Notification": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "nullable": true
          },
          "kind": {
            "type": "string",
            "example": "plain"
          }
        }
      },
      "com.vaadin.hilla.parser.plugins.subtypes.NotificationUnion": {
        "type": "object",
        "discriminator": {
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/components/schemas/com.vaadin.hilla.parser.plugins.subtypes.Notification"
          },
          {
            "$ref": "#/components/schemas/com.vaadin.hilla.parser.plugins.subtypes.EmailNotification"
          },
          {
            "$ref": "#/components/schemas/com.vaadin.hilla.parser.plugins.subtypes.HtmlEmailNotification"
          },
          {
            "$ref": "#/components/schemas/com.vaadin.hilla.parser.plugins.subtypes.MultipartSmsNotification"
          }
        ]
      },
      "com.vaadin.hilla.parser.plugins.subtypes.EmailNotification": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/com.vaadin.hilla.parser.plugins.subtypes.Notification"
          },
          {
            "type": "object",
            "properties": {
              "address": {
                "type": "string",
                "nullable": true
              },
              "kind": {
                "type": "string",
                "example": "email"
              }
            }
          }
        ]
      },
      "com.vaadin.hilla.parser.plugins.subtypes.HtmlEmailNotification": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/com.vaadin.hilla.parser.plugins.subtypes.EmailNotification"
          },
          {
            "type": "object",
            "properties": {
              "html": {
                "type": "string",
                "nullable": true
              },
              "kind": {
                "type": "string",
                "example": "html-email"
              }
            }
          }
        ]
      },
      "com.vaadin.hilla.parser.plugins.subtypes.MultipartSmsNotification": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/com.vaadin.hilla.parser.plugins.subtypes.SmsNotification"
          },
          {
            "type": "object",
            "properties": {
              "parts": {
                "type": "integer",
                "format": "int32"
              },
              "kind": {
                "type": "string",
                "example": "multipart-sms"
              }
            }
          }
        ]
      },
      "com.vaadin.hilla.parser.plugins.subtypes.Shape": {
        "type": "object"
      },
      "com.vaadin.hilla.parser.plugins.subtypes.ShapeUnion": {
        "type": "object",
        "discriminator": {
          "propertyName": "shape"
        },
        "oneOf": [
          {
            "$ref": "#/components/schemas/com.vaadin.hilla.parser.plugins.subtypes.Circle"
          },
          {
            "$ref": "#/components/schemas/com.vaadin.hilla.parser.plugins.subtypes.Square"
          }
        ]
      },
      "com.vaadin.hilla.parser.plugins.subtypes.Circle": {
        "type": "object",
        "properties": {
          "radius": {
            "type": "number",
            "format": "double"
          },
          "shape": {
            "type": "string",
            "example": "circle"
          }
        }
      },
      "com.vaadin.hilla.parser.plugins.subtypes.Square": {
        "type": "object",
        "properties": {
          "side": {
            "type": "number",
            "format": "double"
          },
          "shape": {
            "type": "string",
            "example": "square"
          }
        }
      },
      "com.vaadin.hilla.parser.plugins.subtypes.SmsNotification": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/com.vaadin.hilla.parser.plugins.subtypes.Notification"
          },
          {
            "type": "object",
            "properties": {
              "number": {
                "type": "string",
                "nullable": true
              }
            }
          }
        ]
      }
    }
  }
}
