<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.vaadin</groupId>
        <artifactId>tests-spring</artifactId>
        <version>25.4-SNAPSHOT</version>
    </parent>
    <artifactId>tests-spring-native</artifactId>
    <name>ITs for Hilla compiled to native</name>
    <packaging>jar</packaging>

    <!-- This module is only in the reactor when the `native` profile is
         active, because building a GraalVM native image takes minutes and
         needs a GraalVM JDK. Build and test it with

           mvn -Pnative,production verify -pl packages/java/tests/spring/native

         which compiles the application to a native binary, starts that binary
         and runs the ITs against it. While writing an IT it is quicker to run
         the application on the JVM with `mvn spring-boot:run` in this
         directory and the ITs with failsafe against it. -->

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
        <formatter.basedir>${project.parent.parent.parent.basedir}</formatter.basedir>
        <!-- Neither the Spring Boot bom nor vaadin-parent manages the GraalVM
             build tools, so the version lives here. Keep it in step with the
             native-build-tools-plugin.version of the Spring Boot release in
             the root pom. -->
        <native-maven-plugin.version>1.1.8</native-maven-plugin.version>
        <exec-maven-plugin.version>3.1.0</exec-maven-plugin.version>
        <!-- No coverage is collected from this module, and the agent runs on
             the GraalVM that builds the image, whose class files JaCoCo 0.8.10
             cannot read: it answered every JDK class it was handed with an
             "Unsupported class file major version 69" stack trace, which was
             most of the output of the job. -->
        <jacoco.skip>true</jacoco.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Note: no spring-boot-devtools here. Devtools is not part of a
             native image, so a non-optional dependency on it makes the binary
             fail at startup with a ClassNotFoundException for
             RestartScopeInitializer. -->
    </dependencies>

    <build>
        <defaultGoal>spring-boot:run</defaultGoal>
        <plugins>
            <plugin>
                <groupId>com.vaadin</groupId>
                <artifactId>hilla-maven-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>native</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <executions>
                            <!-- The AOT processing the native image needs: it
                                 generates the bean definitions and the runtime
                                 hints, including Hilla's own. -->
                            <execution>
                                <id>process-aot</id>
                                <goals>
                                    <goal>process-aot</goal>
                                </goals>
                            </execution>
                            <!-- The parent pom starts and stops the
                                 application on the JVM around the ITs. In a
                                 native build the binary is what has to be
                                 tested, so these two are turned off and the
                                 binary is started below instead. -->
                            <execution>
                                <id>pre-integration-test</id>
                                <phase>none</phase>
                                <goals>
                                    <goal>start</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>post-integration-test</id>
                                <phase>none</phase>
                                <goals>
                                    <goal>stop</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>${native-maven-plugin.version}</version>
                        <extensions>true</extensions>
                        <configuration>
                            <!-- The image is built from the classes and the
                                 AOT output, not from the repackaged jar. -->
                            <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                            <metadataRepository>
                                <enabled>true</enabled>
                            </metadataRepository>
                        </configuration>
                        <executions>
                            <execution>
                                <id>add-reachability-metadata</id>
                                <goals>
                                    <goal>add-reachability-metadata</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>build-native</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>${exec-maven-plugin.version}</version>
                        <configuration>
                            <!-- The image name defaults to the artifact id.
                                 Windows would need a .exe suffix here; the
                                 native validation job runs on Linux only. -->
                            <executable>${project.build.directory}/${project.artifactId}</executable>
                            <arguments>
                                <argument>--server.port=${server.port}</argument>
                            </arguments>
                            <async>true</async>
                            <asyncDestroyOnShutdown>true</asyncDestroyOnShutdown>
                        </configuration>
                        <executions>
                            <execution>
                                <id>start-native-application</id>
                                <phase>pre-integration-test</phase>
                                <goals>
                                    <!-- `exec` has no default phase, so an
                                         execution without one never runs. -->
                                    <goal>exec</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
